  "narration_anchors": [
    {"narration": "林大壮跌下山崖，醒来时，掌心竟多了一道山神印。", "required_event_ids": ["cliff-awakening"], "preferred_delay_seconds": 0.0, "post_roll_seconds": 1.0},
    {"narration": "随着金光涌入身体，他听见了整座山的回应。", "required_event_ids": ["mountain-response"], "preferred_delay_seconds": 0.2, "post_roll_seconds": 1.0},
    {"narration": "循着感应挖下去，土里竟是一株五十年份的野山参。", "required_event_ids": ["ginseng-visible"], "preferred_delay_seconds": 0.2, "post_roll_seconds": 1.0},
    {"narration": "兄妹俩还没缓过神，狼群已经围了上来。", "required_event_ids": ["wolves-surround"], "preferred_delay_seconds": 0.2, "post_roll_seconds": 1.0},
    {"narration": "他下意识抬起手，刚才还逼近的野狼，竟齐齐低头退去。", "required_event_ids": ["wolves-retreat"], "preferred_delay_seconds": 0.2, "post_roll_seconds": 1.0},
    {"narration": "可狼群刚退，家里的赌债又压到了妹妹身上。", "required_event_ids": ["debt-pressure"], "preferred_delay_seconds": 0.2, "post_roll_seconds": 1.0},
    {"narration": "看着妹妹，他只说了一句：你的大学，我来供。", "required_event_ids": ["promise-to-sister"], "preferred_delay_seconds": 0.2, "post_roll_seconds": 1.0},
    {"narration": "为了兑现承诺，他带着人参进城，却先被当成了穷鬼。", "required_event_ids": ["enter-pharmacy"], "preferred_delay_seconds": 0.3, "post_roll_seconds": 1.0},
    {"narration": "店家明明认出了极品，嘴上却只肯出二十万。", "required_event_ids": ["lowball-offer"], "preferred_delay_seconds": 0.3, "post_roll_seconds": 1.0},
    {"narration": "直到真正识货的买家赶到，五十万现金当场摆在眼前。", "required_event_ids": ["cash-offer"], "preferred_delay_seconds": 0.2, "post_roll_seconds": 1.0},
    {"narration": "可钱刚到手，讨债的人就抓住妹妹，逼他把钱全部交出来。", "required_event_ids": ["sister-seized"], "preferred_delay_seconds": 0.2, "post_roll_seconds": 1.0},
    {"narration": "山神印再次亮起。这一次，他兑现了承诺，也护住了妹妹。", "required_event_ids": ["sister-protected"], "preferred_delay_seconds": 0.2, "post_roll_seconds": 0.5}
